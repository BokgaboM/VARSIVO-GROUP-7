PORT=3000
NODE_ENV=development
JWT_SECRET=your_secret_here_generate_with_crypto
JWT_EXPIRES_IN=7d

# Azure SQL (accounts, bursaries, institutions, applications)
DB_SERVER=your-server.database.windows.net
DB_DATABASE=your-db-name
DB_USER=your-user
DB_PASSWORD=your-password
DB_PORT=1433

# --- Part 3: Firebase (Firestore NoSQL database + Cloud Messaging push notifications) ---
# Use ONE of these two (never commit the key file itself):
#   a) path to the service-account JSON you downloaded from the Firebase console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#   b) the JSON itself or base64 of it (for hosting such as Azure App Service)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared secret for the operator endpoints (broadcast, deadline alerts). Leave empty to disable them.
ADMIN_API_KEY=change_me_to_a_long_random_string

# Optional: send "bursary closing soon" alerts automatically once a day
ENABLE_DEADLINE_JOB=false
